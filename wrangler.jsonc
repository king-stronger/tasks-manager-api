{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tasks-manager-api",
	"main": "src/app.ts",
	"compatibility_date": "2025-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"FRONTEND_URL": "https://tasks-manager-app.strongerprojects.workers.dev"
	}
}
